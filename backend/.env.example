# Template environment variable. Salin menjadi `.env` lalu isi nilai aslinya.
# File `.env` TIDAK boleh di-commit ke GitHub.

NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmastock
DB_USER=pharmastock_app
DB_PASSWORD=ganti_dengan_password_yang_aman

# JWT (dipakai di Fase 3)
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=15m

# CORS: alamat frontend yang boleh memanggil API
FRONTEND_URL=http://localhost:3000
